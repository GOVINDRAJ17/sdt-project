# Application
ENVIRONMENT=development
PROJECT_NAME="Secure Heatwave Advisory Generator"
API_V1_PREFIX="/api/v1"

# Security & JWT Auth
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite:///./heatwave.db

# LLM Provider Configuration
# Options: mock, openai, anthropic
LLM_PROVIDER=mock

# Real Provider API Keys (leave blank when using mock)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Mock LLM Testing Controls
# Failure Modes: NONE, WRONG_SEVERITY, WRONG_TEMPERATURE, WRONG_REGION, INJECTED_TEXT, CANARY_LEAK, INVALID_JSON, UNAPPROVED_ACTIONS
MOCK_LLM_FAILURE_MODE=NONE
MOCK_LLM_LATENCY_MS=0

# Security Canary Token for Prompt Leak Detection
SYSTEM_CANARY_TOKEN=CANARY-IMD-SEC-9981

# CORS Settings (JSON array format)
ALLOWED_ORIGINS='["http://localhost:5173", "http://localhost:3000"]'
